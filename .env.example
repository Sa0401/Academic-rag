# Academic RAG Studio Environment Configuration
# Get your OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Pinecone Serverless Vector Database (https://www.pinecone.io/)
# If omitted, ScholarRAG automatically uses an in-memory vector store.
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=academic-rag
